# Copy to .env locally and replace placeholders; load it only in your own shell.
# Never put credentials or tokens here. Hosted Foundry injects project context.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ID=/subscriptions/<subscription>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<existing-model-deployment>
AGENT_NAME=registry-hosted-agent-local
DEPLOYMENT_SOURCE=zip
PYTHONNOUSERSITE=1
AZURE_SUBSCRIPTION_ID=<subscription>
AZURE_RESOURCE_GROUP=<group>
AZURE_LOCATION=<supported-region>
ACR_NAME=<existing-acr>
ACR_IMAGE=<acr>.azurecr.io/<image>:<unique-build-tag>
JFROG_IMAGE=<registry-host>/<repository>/<image>@sha256:<manifest-digest>
REGISTRY_CONNECTION_NAME=<existing-project-registry-connection>
JFROG_REGISTRY_ORIGIN=https://<registry-host>
JFROG_AUDIENCE=<entra-application-id>
JFROG_OIDC_PROVIDER_NAME=<administrator-confirmed-provider>
JFROG_TOKEN_ENDPOINT=/access/api/v1/oidc/token
